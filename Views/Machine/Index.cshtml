@model tec_parts_supply_transport_web.Models.MMachineModel;
@{
    ViewData["Title"] = "稼働状況 : 選択";
}
<div class="zone">
    <div class="inner">
        <div class="menu-top shadow-lg bg-white">
            <div class="system_title text-center mt-4">
                <span class="h3 cl-001E64 font-weight-bold">
                    稼働状況
                </span>
            </div>
            <div class="system_title text-center my-2">
                <span class="font-weight-bold">
                    稼働状況を確認するゾーンを選択してください
                </span>
            </div>
            <div class="option-list text-center mb-5 mt-2 d-block">
                @if (@Model != null && @Model.SearchList != null && @Model.SearchList.Count > 0)
                    {
                    @foreach (var item in @Model.SearchList)
                    {
                        <div class="my-3 py-2">
                            <div class="option-item">
                                <a asp-controller="Machine" asp-action="Status" asp-route-zone='@item.Zone'>@item.Zone</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    html {
        background: #FFFF;
    }
</style>