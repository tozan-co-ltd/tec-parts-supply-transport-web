@{
    ViewData["Title"] = "稼働状況 : 選択";
}
<div class="zone">
    <div class="inner">
        <div class="menu-top shadow-lg bg-white">
            <div class="system_title text-center mt-4">
                <span class="h3 cl-001E64 font-weight-bold">
                    稼働状況
                </span>
            </div>
            <div class="system_title text-center my-2">
                <span class="font-weight-bold">
                    稼働状況を確認するゾーンを選択してください
                </span>
            </div>
            <div class="option-list text-center mb-5 mt-2 d-block">
                <div class="option-item my-3 py-2">
                    <a asp-controller="Machine" asp-action="Status" asp-route-division="1">ゾーン：1</a>
                </div>
                <br />
                <div class="option-item my-3 py-2">
                    <a asp-controller="Machine" asp-action="Status" asp-route-division="2">ゾーン：2</a>
                </div>
                <br />
                <div class="option-item my-3 py-2" ">
                    <a asp-controller="Machine" asp-action="Status" asp-route-division="3">ゾーン：3</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    html {
        background: #FFFF;
    }
</style>