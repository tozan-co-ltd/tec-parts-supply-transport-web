@{
    ViewData["Title"] = "稼働状況";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="machine" id="machine-page">
    <div class="card text-white">
        <div class="row machine-table-content" style="display: none">
            <table id="machineTable" class="table table-striped table-dark equal-cols">
                <thead>
                    <tr>
                        <th>機番</th>
                        <th>稼働状況</th>
                        <th>終了時間</th>
                    </tr>
                </thead>
                <tbody id="machine-table-row">
                </tbody>
            </table>
        </div>

        <div class="noneDateMess text-center text-danger" style="display: none">E2007 該当データがありません。</div>
        <div class="connectionTransportError text-center text-danger" style="display: none">E3003 ネットワークに接続できませんでした。</div>
    </div>
</div>